{"success":true,"data":{"found":true,"date":"2012-11-29","day_label":"Thursday 29th November 2012","report_id":195,"filename":"RDR29112_2012-11-29.HTM","download_url":"http://localhost/racedayreports/RDR29112_2012-11-29.HTM","file_exists":true,"report_html":"<html>\r\n\r\n<head>\r\n<meta http-equiv=Content-Type content=\"text/html; charset=windows-1252\">\r\n<meta name=Generator content=\"Microsoft Word 12 (filtered)\">\r\n<style>\r\n<!--\r\n /* Font Definitions */\r\n @font-face\r\n\t{font-family:Wingdings;\r\n\tpanose-1:5 0 0 0 0 0 0 0 0 0;}\r\n@font-face\r\n\t{font-family:\"Cambria Math\";\r\n\tpanose-1:2 4 5 3 5 4 6 3 2 4;}\r\n@font-face\r\n\t{font-family:Calibri;\r\n\tpanose-1:2 15 5 2 2 2 4 3 2 4;}\r\n@font-face\r\n\t{font-family:\"Trebuchet MS\";\r\n\tpanose-1:2 11 6 3 2 2 2 2 2 4;}\r\n@font-face\r\n\t{font-family:Sydnie;}\r\n@font-face\r\n\t{font-family:\"Arial Narrow\";\r\n\tpanose-1:2 11 5 6 2 2 2 3 2 4;}\r\n /* Style Definitions */\r\n p.MsoNormal, li.MsoNormal, div.MsoNormal\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:12.0pt;\r\n\tfont-family:Wingdings;}\r\np.MsoNoSpacing, li.MsoNoSpacing, div.MsoNoSpacing\r\n\t{margin:0in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:11.0pt;\r\n\tfont-family:Symbol;}\r\np.MsoListParagraph, li.MsoListParagraph, div.MsoListParagraph\r\n\t{margin-top:0in;\r\n\tmargin-right:0in;\r\n\tmargin-bottom:0in;\r\n\tmargin-left:.5in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:12.0pt;\r\n\tfont-family:Wingdings;}\r\np.MsoListParagraphCxSpFirst, li.MsoListParagraphCxSpFirst, div.MsoListParagraphCxSpFirst\r\n\t{margin-top:0in;\r\n\tmargin-right:0in;\r\n\tmargin-bottom:0in;\r\n\tmargin-left:.5in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:12.0pt;\r\n\tfont-family:Wingdings;}\r\np.MsoListParagraphCxSpMiddle, li.MsoListParagraphCxSpMiddle, div.MsoListParagraphCxSpMiddle\r\n\t{margin-top:0in;\r\n\tmargin-right:0in;\r\n\tmargin-bottom:0in;\r\n\tmargin-left:.5in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:12.0pt;\r\n\tfont-family:Wingdings;}\r\np.MsoListParagraphCxSpLast, li.MsoListParagraphCxSpLast, div.MsoListParagraphCxSpLast\r\n\t{margin-top:0in;\r\n\tmargin-right:0in;\r\n\tmargin-bottom:0in;\r\n\tmargin-left:.5in;\r\n\tmargin-bottom:.0001pt;\r\n\tfont-size:12.0pt;\r\n\tfont-family:Wingdings;}\r\n@page Section1\r\n\t{size:8.5in 13.5in;\r\n\tmargin:1.0in 40.3pt 1.0in 1.0in;}\r\ndiv.Section1\r\n\t{page:Section1;}\r\n /* List Definitions */\r\n ol\r\n\t{margin-bottom:0in;}\r\nul\r\n\t{margin-bottom:0in;}\r\n-->\r\n</style>\r\n\r\n</head>\r\n\r\n<body lang=EN-US>\r\n\r\n<div class=Section1>\r\n\r\n<p class=MsoNoSpacing align=center style='margin-right:4.7pt;text-align:center'><b><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\";color:red'>ROYAL WESTERN INDIA\r\nTURF CLUB, LTD.</span></b></p>\r\n\r\n<p class=MsoNormal align=center style='margin-right:4.7pt;text-align:center'><b><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:red'>MUMBAI\r\nMEETING 2012/13, FOURTH DAY, THURSDAY, 29<sup>TH</sup> NOVEMBER, 2012.</span></b></p>\r\n\r\n<p class=MsoNoSpacing align=center style='margin-right:4.7pt;text-align:center'><b><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\";color:red'>(PENETROMETER: 2.1;\r\nGOING: GOOD)</span></b></p>\r\n\r\n<p class=MsoNoSpacing align=center style='margin-right:4.7pt;text-align:center'><b><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>RACE DAY REPORTS</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><b><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:black'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><b><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:black'>RAILS\r\nWERE PLACED 5 METRES AWAY FROM ITS ORIGINAL POINT FROM 1600 METRES (MILE CHUTE)\r\nTO 1200 METRES AND THEREAFTER 7 METRES AWAY UPTO THE WINNING POST. FOR&nbsp;\r\nTHE RACES STARTING FROM THE BACK STRETCH, RAILS WERE PLACED FROM ITS ORIGINAL\r\nPOINT&nbsp; FROM 1400 METRES LEADING TO 3 METRES AWAY AT 1200 METRES AND 7\r\nMETRES AWAY AT 1000 METRES.</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\"Trebuchet MS\",\"sans-serif\"'>On\r\na request from Trainer Janardhan, permission was granted to Trainer Vinesh to\r\nsaddle his charge PTOLEMY in the 5<sup>th </sup>race, at his (Trainer\r\nJanardhan’s) risk and responsibility.</span></p>\r\n\r\n<p class=MsoNoSpacing align=center style='text-align:center'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>---------------------------</span></p>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><b><u><span style='font-family:\r\n\"Trebuchet MS\",\"sans-serif\";color:red'>CHANGE OF JOCKEY:</span></u></b></p>\r\n\r\n<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0\r\n style='margin-left:5.4pt;border-collapse:collapse;border:none'>\r\n <tr>\r\n  <td width=60 valign=top style='width:45.15pt;border:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing align=center style='text-align:center'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>RACE</span></b></p>\r\n  </td>\r\n  <td width=146 valign=top style='width:109.45pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing align=center style='text-align:center'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>HORSE</span></b></p>\r\n  </td>\r\n  <td width=111 valign=top style='width:83.5pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing align=center style='text-align:center'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>JOCKEY</span></b></p>\r\n  </td>\r\n  <td width=124 valign=top style='width:93.3pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing align=center style='text-align:center'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>REPLACED BY</span></b></p>\r\n  </td>\r\n  <td width=224 valign=top style='width:168.1pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing align=center style='text-align:center'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>REASON</span></b></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=60 valign=top style='width:45.15pt;border:solid black 1.0pt;\r\n  border-top:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>5 (29)</span></p>\r\n  </td>\r\n  <td width=146 valign=top style='width:109.45pt;border-top:none;border-left:\r\n  none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>PRIVATE NUMBER</span></p>\r\n  </td>\r\n  <td width=111 valign=top style='width:83.5pt;border-top:none;border-left:\r\n  none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>Kavraj Singh</span></p>\r\n  </td>\r\n  <td width=124 valign=top style='width:93.3pt;border-top:none;border-left:\r\n  none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>M.A.Roushan</span></p>\r\n  </td>\r\n  <td width=224 valign=top style='width:168.1pt;border-top:none;border-left:\r\n  none;border-bottom:solid black 1.0pt;border-right:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>Injured in the 4<sup>th</sup> race</span></p>\r\n  </td>\r\n </tr>\r\n</table>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><b><span style='font-family:\r\n\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><b><u><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE\r\nNO.1(25)  – THE  ASTANA PLATE (DIV.II) </span></u></b><b><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>:\r\n(About) 1200 Metres – Runners - 9<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>At the start, ADAMS VISION (Kavraj\r\nSingh) jumped awkwardly outwards and went on to WINDS OF CHANGE (Suraj\r\nNarredu).</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>ALLEGIANCE (Shrikant Kamble) lugged-in\r\nin the straight. Trainer Narendra Lagad has been asked to take remedial\r\nmeasures before next accepting to race the gelding.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey Kavraj Singh (ADAMS VISION) has\r\nbeen fined Rs.3,000/- for using the whip in excess of the prescribed limit on\r\nhis mount.&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:12.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey Amyn\r\nMerchant (ASHWA YODHAA) has been cautioned for indifferent handling of his\r\nmount in the final 200 metres.</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:12.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:12.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, WINDS OF CHANGE was observed to have broken a blood vessel and is not to\r\nrace for the stipulated period of 4 weeks. The gelding has to be passed fit by\r\nthe Club’s VO before next accepting to race. </span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>After the race, SILVER LINING\r\nwas found to be sore by the left fore leg. The filly has to be passed fit by\r\nthe Club’s VO before next accepting to race.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>After the race, ALLEGIANCE,\r\nDANCING DOLLY and ASHWA YODHAA were found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.2(26) –\r\nTHE AZTEC PLATE</span></u></b><b><span style='font-size:11.0pt;font-family:\r\n\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1800 Metres – Runners - 6</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>After the race, HONEY BEE was\r\nfound to be sore by the right fore leg. The mare has to be passed fit by the\r\nClub’s VO before next accepting to race.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>After the race, WIND OF THE\r\nHILLS was found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.3(27) –\r\nTHE SHANTIDAS ASKURAN TROPHY</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1000 Metres –\r\nRunners – 4<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey C.S.Jodha (BORDERLINE) has been\r\nfined Rs.3,000/- for Improper use of the whip wherein he persisted with the use\r\nof the whip with his right hand as his mount shifted outwards and possibly lost\r\nthe 2<sup>nd</sup> place.   <b>&nbsp;</b></span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>After the race, VISIONIST and\r\nBORDERLINE were found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.4(28) –\r\nTHE  FETCHMEFORTUNE PLATE</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1600 Metres –\r\nRunners – 5<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>BLUE MELLON (S.Sunil) lost 3 lengths\r\nat the start.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>Near 1400\r\nmetres, BLUE MELLON (S.Sunil) wobbled and was pulled up by its rider. T</span><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>he gelding was\r\nexamined by the Club’s V.O. and found to be sore from left fore leg with\r\nswelling at the fetlock joint. First aid treatment was given and the gelding\r\nwas sent to the Equine Hospital by Horse Ambulance for further management. \r\nSubsequently, the Equine Hospital reported fracture of both sesamoid left fore\r\nfetlock. After consent of the trainer, the horse was euthanized on humane\r\ngrounds.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>When questioned, Jockey Malcolm\r\nKharadi (WALK OF LIFE) stated that his Instructions were to settle his mount\r\nand ride out in the last 400 metres. He opined that the pace of the race was\r\ntoo fast for his mount and she could not pace with them and if he had chased\r\nthem, possibly his mount could not have lasted till the end of the race,\r\nwhereas, the eventual Winner was travelling well. The explanation was noted.  </span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>When questioned, Jockey P.Trevor\r\n(IBIS) stated that his Instructions were to sit off the pace and ride his race,\r\nsince the mare had won in that manner. He too opined that the pace was too fast\r\nand he felt that the front runners would drop out. The explanation was noted.  </span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Tr.Narendra Lagad was questioned\r\nregarding the inconsistent performance of  REINSTATE, wherein the mare\r\nperformed poorly in Race No.9 and Placed second today.  He stated that when the\r\nmare raced in Race No 9 on 20<sup>th</sup> November, 2012 it was her first race\r\nduring the current Mumbai Meeting and she may not have taken the travel well.\r\nHe added that in both the races, the running pattern was similar. He further\r\nadded that in today’s race, one of the fancied runners did not complete the\r\nrace and the other two also did not run well and his mare put its best foot\r\nforward. While noting the explanation, the Trainer has been advised to ensure\r\nthat his horses run with more consistency in the future.    </span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, WALK OF LIFE and IBIS were found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.5(29) –\r\nTHE KANTHARA PLATE (DIV.II)</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1200 Metres –\r\nRunners - 16<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>ELECTRA (R.Shelar) lost 2 lengths at\r\nthe start.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'><span style='text-decoration:\r\n none'>&nbsp;</span></span></u></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>At the start, STORMYDAY (J.Pradeep)\r\nlugged inwards. Trainer H.J.Antia has been asked to take remedial measures\r\nbefore next accepting to race the gelding.<b> &nbsp;</b></span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey M.A.Roushan (PRIVATE NUMBER)\r\nreported that his mount ran green and was inclined to lug outwards throughout\r\nthe race whereby he could not ride out his mount to complete advantage. Trainer\r\nH.J.Antia has been asked to take remedial measures before next accepting to\r\nrace the filly.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey Hamir Singh (STAR ZONE)\r\nreported loss of whip near 400 metres.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'><span style='text-decoration:\r\n none'>&nbsp;</span></span></u></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, NEPTUNE, PRIVATE NUMBER and BLUE KNIGHT were found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'><span style='text-decoration:\r\n none'>&nbsp;</span></span></u></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.6(30) –\r\nTHE M.H. AHMEDBHOY TROPHY</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 2000 Metres  –\r\nRunners - 5<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:black'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>At the start, MOUNTAIN FORCE (Suraj\r\nNarredu) fly jumped.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Near 600 metres, MOUNTAIN FORCE (Suraj\r\nNarredu) shifted out due to the bend and made contact with BELMONT (S.Zervan)\r\nwho became unbalanced and leaned in on to MOUNTAIN FORCE, causing the latter to\r\nshift in and make contact with CAESARS STAR (C.S.Jodha). Since the incident was\r\naccidental, no action has been initiated in the matter.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'> </span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey C.S.Jodha (CAESARS STAR) has\r\nbeen reprimanded for allowing his mount to drift outwards in the final 200\r\nmetres. </span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, BELMONT and CAESARS STAR were found to be sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.7(31) –\r\nTHE ASTANA PLATE (DIV.I)</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1200 Metres –\r\nRunners - 9<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>After a slow start, ACE OF DIAMOND\r\n(R.K.Mahesh) veered to the outside.  At the start, ENLIGHTENING (I.Pasha)\r\njumped awkwardly inwards and made contact DESERT EAGLE (D.K.Ashish) and then\r\nricocheted and shifted out, due to which GREAT SNIPE (Shammi Khan) shied away\r\nand drifted out. Both the horses, GREAT SNIPE &amp; ACE OF DIAMOND lost considerable\r\ndistance as they were brought on an even keel. Trainer Damodaran D.Pillai has\r\nbeen asked to remedial measures before next accepting to race his charge ACE OF\r\nDIAMOND. </span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>SHADOWS OF TIME (Suraj Narredu) lugged\r\nout for a brief period in the last 400 metres. Trainer C.D.Katrak has been\r\nasked to take remedial measures before next accepting to race the filly. </span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey Shrikant Kamble (DANSE\r\nDEBONAIRE) has been fined Rs.1,000/- for using the whip in excess of the\r\nprescribed limit on his mount. </span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, DESERT EAGLE, EL WONDER, ENLIGHTENING and GOTTAWEARSHADES were found to\r\nbe sound.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><b><u><span style='font-size:\r\n11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>RACE NO.8(32) –\r\nTHE KANTHARA PLATE (DIV.I)</span></u></b><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\";color:#0070C0'>: (About) 1200 Metres –\r\nRunners – 15<u> </u></span></b></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>At the request of Trainer\r\nFaisal A.Abbas,  DREAMLINER was examined at 1800 hours on 28/11/2012  and was\r\nfound to be sore by the left fore leg, as such, the gelding was certified unfit\r\nto race and was withdrawn on Veterinary grounds. The gelding has to be passed\r\nfit to race by the Club’s VO before next accepting to race.  </span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>AMARA (Vikram\r\nJodha) hooked one of its fore leg on the front gates. The gelding was examined\r\nby the Club’s V.O. who certified him fit to race.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>Passing 1000 metres, ARMEL (App.Prabhu\r\nNaidu) lost his position when tightened while racing on the inside of STAR\r\nBUILDER (Hanumant Singh).</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><b><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></b></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>App S.Mosin (APOCALYPSE) lost his\r\nright stirrup approaching 600 metres, which he regained shortly.</span></p>\r\n\r\n<p class=MsoNormal style='text-align:justify'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\"Trebuchet MS\",\"sans-serif\"'>LAZOR\r\nRAZOR (Shrikant Kamble) hung out in the straight and finished the race along\r\nthe outer rail. Since the gelding had behaved in a similar manner in its\r\nprevious outing, Trainer Narendra Lagad has been asked to show the gelding to\r\nthe satisfaction of the Stipendiary Stewards in a Mock Race, before next\r\naccepting to race. </span></p>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\"Trebuchet MS\",\"sans-serif\"'>Jockey\r\nSuraj Narredu (MABLE) has been fined Rs.1,000/- for using the whip in excess of\r\nthe prescribed limit on his mount.</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt'><span style='font-size:11.0pt;\r\nfont-family:\"Trebuchet MS\",\"sans-serif\"'>&nbsp;</span></p>\r\n\r\n<p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>After the\r\nrace, APOCALYPSE, ARMEL, ICE EMPIRE, STAR LEGACY and LAZOR RAZOR were found to\r\nbe sound.</span></p>\r\n\r\n<p class=MsoNormal align=center style='margin-right:4.7pt;text-align:center'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>----------------------</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>The post race urine sample of\r\nthe winner of 2<sup>nd</sup>, 6<sup>th</sup> and 8<sup>th</sup> race viz.\r\nQUEEN’S CAMP, CAESARS STAR and APOCALYPSE and the special sample of WINDS OF\r\nCHANGE (1<sup>st</sup> race) and WIND OF THE HILLS (2<sup>nd</sup> race), were\r\ncollected for detection of prohibited substance.</span></p>\r\n\r\n<p class=MsoNormal align=center style='margin-right:4.7pt;text-align:center'><span\r\nstyle='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>------------------------------</span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><b><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>TOTAL NUMBER OF RACES -         8   \r\n    TOTAL NUMBER OF RUNNERS -  69</span></b></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><b><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>TOTAL STAKES   - Rs.18,18,000/-\r\n         AVE. NUMBER OF RUNNERS PER RACE  - 8.62                 </span></b></p>\r\n\r\n<p class=MsoNoSpacing align=center style='margin-right:4.7pt;text-align:center'><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\"'>-------------------------------------             </span></p>\r\n\r\n<p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><b><u><span\r\nstyle='font-family:\"Trebuchet MS\",\"sans-serif\";color:red'>SUMMARY:</span></u></b></p>\r\n\r\n<table class=MsoNormalTable border=1 cellspacing=0 cellpadding=0\r\n style='margin-left:5.4pt;border-collapse:collapse;border:none'>\r\n <tr>\r\n  <td width=120 rowspan=4 style='width:90.3pt;border:solid black 1.0pt;\r\n  padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='margin-right:4.7pt;text-align:justify'><b><span\r\n  style='font-family:\"Trebuchet MS\",\"sans-serif\"'>SUSPENSION/ FINE (S)</span></b></p>\r\n  </td>\r\n  <td width=67 valign=top style='width:50.6pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNormal style='margin-right:4.7pt;text-align:justify'><b><span\r\n  style='font-size:11.0pt;font-family:\"Trebuchet MS\",\"sans-serif\"'>R.1(25)</span></b></p>\r\n  </td>\r\n  <td width=466 valign=top style='width:349.6pt;border:solid black 1.0pt;\r\n  border-left:none;padding:0in 5.4pt 0in 5.4pt'>\r\n  <p class=MsoNoSpacing style='text-align:justify'><span style='font-family:\r\n  \"Trebuchet MS\",\"sans-serif\"'>Joc.Kavraj Singh - fined Rs.3,000/- (whip\r\n  offence)</span></p>\r\n  </td>\r\n </tr>\r\n <tr>\r\n  <td width=67 valign=top style='width:50.6pt;border-top:none;border-left:none;\r\n  border-bottom: